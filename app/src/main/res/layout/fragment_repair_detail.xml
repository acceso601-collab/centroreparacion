<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/tvHeader" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvClient" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvProblem" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="8dp" />
        <Spinner android:id="@+id/spinnerStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvCost" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold"
            android:layout_marginTop="8dp" android:textColor="#4CAF50" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Checklist" android:textSize="18sp" android:textStyle="bold"
            android:layout_marginTop="16dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChecklist"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Mediciones" android:textSize="18sp" android:textStyle="bold"
            android:layout_marginTop="16dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMeasurements"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <EditText android:id="@+id/etMeasureType" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:hint="Tipo" />
            <EditText android:id="@+id/etMeasureValue" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:hint="Valor"
                android:inputType="numberDecimal" />
            <EditText android:id="@+id/etMeasureUnit" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:hint="Unidad" />
        </LinearLayout>
        <EditText android:id="@+id/etMeasurePoint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Punto de medición" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMeasure" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="+ Añadir medición" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
